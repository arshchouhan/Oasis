CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Image review: add a real key in .env (never commit it), then restart Django.
# Images are sent to OpenAI only when this key is configured and AI review runs.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-4.1-mini
# Gemini free-tier result chat (create a key in Google AI Studio).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# Or use Cloudinary's single connection-string format instead:
# CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
